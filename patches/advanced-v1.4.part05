+                val w = maxOf(1, (shot.width * ratio).toInt())
+                val h = maxOf(1, (shot.height * ratio).toInt())
+                val scaled = if (w == shot.width && h == shot.height) shot
+                    else Bitmap.createScaledBitmap(shot, w, h, true)
